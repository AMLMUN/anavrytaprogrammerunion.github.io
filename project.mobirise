ceholder=\"Εισάγετε κείμενο\">Agenda</a><a class=\"text-black show dropdown-item text-primary\" href=\"unavailable.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Εισάγετε κείμενο\">Pictures</a></div></div><div class=\"dropdown\"><a class=\"text-black dropdown-item dropdown-toggle\" href=\"https://mobiri.se\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Εισάγετε κείμενο\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\">2nd AML MUN</a><div class=\"dropdown-menu dropdown-submenu\" aria-labelledby=\"dropdown-718\"><a class=\"text-black show dropdown-item text-primary\" href=\"unavailable.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Εισάγετε κείμενο\">Agenda</a><a class=\"text-black show dropdown-item text-primary\" href=\"unavailable.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Εισάγετε κείμενο\">Pictures</a></div></div><div class=\"dropdown\"><a class=\"text-black dropdown-item dropdown-toggle\" href=\"https://mobiri.se\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Εισάγετε κείμενο\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\">1st AML MUN</a><div class=\"dropdown-menu dropdown-submenu\" aria-labelledby=\"dropdown-937\"><a class=\"text-black show dropdown-item text-primary\" href=\"unavailable.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Εισάγετε κείμενο\">Pictures</a></div></div></div></li></ul>\n\t\t\t\t<div class=\"icons-menu\" mbr-if=\"showIcons\">\n\t\t\t\t\t<a class=\"iconfont-wrapper\" href=\"tel:+302108012944\">\n\t\t\t\t\t\t<span mbr-icon class=\"p-2 mbr-iconfont mobi-mbri-phone mobi-mbri\"></span>\n\t\t\t\t\t</a>\n\t\t\t\t\t<a class=\"iconfont-wrapper\" href=\"mailto:amlmun@gmail.com\" mbr-if=\"iconsAmount > 1\">\n\t\t\t\t\t\t<span mbr-icon class=\"